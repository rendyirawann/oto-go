APP_NAME=OtoGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8822
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database utama OtoGo (PostgreSQL 16+ dengan PostGIS)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=oto_go
DB_USERNAME=postgres
DB_PASSWORD=

# Sesi disimpan di database agar halaman "Sesi Login" dan "logout perangkat lain" berfungsi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set true setelah aplikasi berjalan di HTTPS.
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local

# Redis untuk cache, queue, rate limit, dan lock.
# predis dipakai karena tidak butuh ekstensi PHP tambahan (phpredis opsional).
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@otogo.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Keamanan
# ---------------------------------------------------------------------------
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_UPGRADE_INSECURE=false
SECURITY_CSP_EXTRA_HOSTS=
# Aktifkan di produksi setelah HTTPS dipastikan berjalan (header disimpan browser 1 tahun).
SECURITY_HSTS=false
SECURITY_BLOCK_SUSPICIOUS=true

# Batas request per menit.
RATE_LIMIT_WEB=600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PASSWORD=6
RATE_LIMIT_WRITE=120
RATE_LIMIT_API=240

# CORS hanya berlaku untuk api/*. Pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
CORS_ALLOWED_ORIGIN_PATTERNS=

# Isi hanya bila berada di belakang reverse proxy (nginx/Cloudflare).
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Akun superadmin awal (SuperAdminSeeder). Kosongkan password untuk dibuatkan acak.
# ---------------------------------------------------------------------------
SUPERADMIN_EMAIL=superadmin@otogo.id
SUPERADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Tripay (payment gateway) - closed payment
# ---------------------------------------------------------------------------
TRIPAY_MODE=sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
PLATFORM_DEFAULT_COMMISSION_PERCENT=5

# ---------------------------------------------------------------------------
# API & dokumentasi Swagger (/api/documentation)
# ---------------------------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST="${APP_URL}"
# Masa berlaku token API dalam menit (43200 = 30 hari).
SANCTUM_TOKEN_EXPIRATION=43200
MOBILE_WEB_PORT=5180

# ---------------------------------------------------------------------------
# Bantuan AI (agen AI di portal + aplikasi mobile)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_CADANGAN=openai/gpt-oss-120b
# Opsional: model Groq dengan pencarian web bawaan. Kosong = pakai Tavily.
GROQ_MODEL_WEB=
TAVILY_API_KEY=
# Permintaan chat AI per menit per pengguna.
AI_RATE_LIMIT=30

# Octane (opsional; untuk lokal cukup php artisan serve)
OCTANE_SERVER=roadrunner
