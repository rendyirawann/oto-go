<?xml version="1.0" encoding="utf-8"?>
<!--
    API pengembangan berjalan di HTTP pada jaringan lokal, sedangkan Android 9+
    memblokir cleartext secara bawaan. Konfigurasi ini membuka HTTP hanya untuk
    alamat pengembangan.

    CATATAN UNTUK PRODUKSI: pindahkan API ke HTTPS, lalu ganti
    cleartextTrafficPermitted menjadi "false" dan hapus atribut
    android:usesCleartextTraffic pada AndroidManifest.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Alias host komputer dari emulator Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
